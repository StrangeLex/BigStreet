{
  "name": "bigstreet-launcher",
  "productName": "Big Street",
  "version": "1.6.1",
  "description": "Launcher officiel de Big Street — ouvre le jeu dans une fenêtre native, se met à jour tout seul.",
  "main": "src/main.js",
  "author": "StrangeLex",
  "license": "MIT",
  "homepage": "https://playbigstreet.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/StrangeLex/BigStreet.git"
  },
  "bugs": {
    "url": "https://github.com/StrangeLex/BigStreet/issues"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "selftest": "electron tools/selftest.mjs --no-sandbox"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "openrgb-sdk": "0.6.0"
  }
